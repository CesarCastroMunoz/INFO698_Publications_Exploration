# Copy this file to prod.env in the repository root and replace the placeholders.
# PowerShell: Copy-Item .env.example prod.env
# The project loads prod.env, not .env. Existing environment variables take precedence.
# Never commit prod.env or real credentials. This example contains placeholders only.

# Required for the Streamlit app, database setup, and publication/graph ingestion.
# PostgreSQL connection URI (Neon or another compatible PostgreSQL database).
# URL-encode special characters in the username and password.
NEON_DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE?sslmode=require

# Required for OpenAI embeddings and AI features.
# The variable name used by this project is OPENAI_KEY, not OPENAI_API_KEY.
OPENAI_KEY=YOUR_OPENAI_API_KEY

# Used by the OpenAlex data collection pipeline.
OPENALEX_API_KEY=YOUR_OPENALEX_API_KEY
USER_EMAIL=developer@example.com

# Optional: Semantic Scholar API key for authenticated data collection requests.
# Leave empty to send requests without an API key.
S2_API_KEY=

# For Docker, supply the values at runtime with --env-file prod.env.
# ArXiv data collection does not require an API key.
